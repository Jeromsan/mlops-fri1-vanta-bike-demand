2026-11-13T08:23:23.2312246Z     )
2026-11-13T08:23:23.2312490Z     def test_one_private_json_event_per_request(artifact_dir, case, expected):
2026-11-13T08:23:23.2312766Z         import logging
2026-11-13T08:23:23.2312932Z     
2026-11-13T08:23:23.2313096Z         from bike_demand.api import EVENTS
2026-11-13T08:23:23.2313298Z     
2026-11-13T08:23:23.2313445Z         lines = []
2026-11-13T08:23:23.2313592Z     
2026-11-13T08:23:23.2313740Z         class Collector(logging.Handler):
2026-11-13T08:23:23.2313948Z             def emit(self, record):
2026-11-13T08:23:23.2314176Z                 lines.append(record.getMessage())
2026-11-13T08:23:23.2314382Z     
2026-11-13T08:23:23.2314532Z         handler = Collector()
2026-11-13T08:23:23.2314722Z         EVENTS.addHandler(handler)
2026-11-13T08:23:23.2315067Z         try:
2026-11-13T08:23:23.2315373Z             app = create_app(artifact_dir)
2026-11-13T08:23:23.2315581Z     
2026-11-13T08:23:23.2315727Z             @app.get("/crash")
2026-11-13T08:23:23.2315905Z             def crash():
2026-11-13T08:23:23.2316125Z                 raise RuntimeError("private-error-content")
2026-11-13T08:23:23.2316343Z     
2026-11-13T08:23:23.2316493Z             with TestClient(app) as client:
2026-11-13T08:23:23.2316700Z                 if case == "unavailable":
2026-11-13T08:23:23.2316925Z                     app.state.loaded_model = None
